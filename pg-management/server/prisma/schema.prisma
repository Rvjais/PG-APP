generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  password        String    @default("")
  name            String    @default("")
  whatsappNumber  String?
  isAdmin         Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  buildings       Building[]
  customFields    CustomField[]
  tenants         Tenant[]
  templates       MessageTemplate[]
  reminders       ScheduledReminder[]
  messageLogs     MessageLog[]
  messageLimit    MessageLimit?
  whatsappSession WhatsAppSession?
}

model WhatsAppSession {
  id        String   @id @default(uuid())
  userId    String   @unique
  connected Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Building {
  id        String   @id @default(uuid())
  ownerId   String
  name      String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tenants  Tenant[]
  reminders ScheduledReminder[]
}

model CustomField {
  id           String      @id @default(uuid())
  ownerId      String
  fieldName    String
  fieldType    CustomFieldType @default(TEXT)
  fieldOptions Json?
  isRequired   Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
}

model Tenant {
  id                String   @id @default(uuid())
  buildingId        String
  ownerId           String
  name              String
  phone             String
  roomNumber        String
  floor             Int      @default(1)
  rentAmount        Float?
  joinDate          DateTime?
  isActive          Boolean  @default(true)
  customFieldValues Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  building   Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  owner      User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  messageLogs MessageLog[]
}

model MessageTemplate {
  id           String   @id @default(uuid())
  ownerId      String
  name         String
  templateText String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner    User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  reminders ScheduledReminder[]
}

model ScheduledReminder {
  id           String       @id @default(uuid())
  ownerId      String
  buildingId   String?
  templateId   String
  triggerType  TriggerType
  triggerValue String
  sendFrom     String?
  sendUntil    String?
  isActive     Boolean      @default(true)
  lastSentAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  owner    User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  building Building?        @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  template MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

enum TriggerType {
  FIXED_DATE
  RELATIVE_TO_JOIN
}

model MessageLog {
  id             String        @id @default(uuid())
  ownerId        String
  tenantId       String
  messageContent String        @db.Text
  imageData      String?       @db.Text
  sentAt         DateTime      @default(now())
  status         MessageStatus

  owner  User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model MessageLimit {
  id          String   @id @default(uuid())
  ownerId     String   @unique
  maxPerMinute Int     @default(3)
  maxPerHour  Int      @default(20)
  maxPerDay   Int      @default(100)
  updatedAt   DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

enum MessageStatus {
  SENT
  FAILED
  PENDING
}