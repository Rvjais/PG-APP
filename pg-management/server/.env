DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pg_management?schema=public"

# BUG #18 FIX: Replace this with a long random secret before deploying to production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

PORT=3001
NODE_ENV=development

# Absolute path where WhatsApp session auth files are stored (BUG #3 FIX).
# Leave empty to use the default: <server_root>/auth/
# AUTH_DIR=/var/www/pg-management/auth

# Default country code prefix for 10-digit phone numbers (BUG #13 FIX).
# Change to your country's code if tenants are not Indian.
PHONE_COUNTRY_CODE=91